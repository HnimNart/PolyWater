
{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": false,
      "generator": "Ninja Multi-Config",
      "description": "Base preset with common clang settings and ccache",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "description": "Release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG -Wall -Wextra",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -Wall -Wextra"
      }
    },
    {
        "name": "relwithdebinfo",
        "inherits": "base",
        "description": "Release build with debug information",
        "cacheVariables": {
            "CMAKE_BUILD_TYPE": "RelWithDebInfo",
            "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -Wall -Wextra",
            "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -Wall -Wextra"
        }
    },
    {
      "name": "debug",
      "inherits": "base",
      "description": "Debug build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-g -O0 -Wall -Wextra",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O0 -Wall -Wextra"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "description": "Build the Release configure preset",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "dev",
      "configurePreset": "relwithdebinfo",
      "description": "Build the RelWithDebInfo configure preset",
      "configuration": "RelWithDebInfo",
      "jobs": 0
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "description": "Build the Debug configure preset",
      "configuration": "Debug",
      "jobs": 0
    }
  ]
}
